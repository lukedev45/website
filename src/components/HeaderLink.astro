---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../utils';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const target = String(href);

// Normalize the current path back to a root-relative path (strip the base).
const base = import.meta.env.BASE_URL;
const current = ('/' + Astro.url.pathname.slice(base.length)).replace(/\/{2,}/g, '/');

const isActive = target === '/' ? current === '/' : current === target || current.startsWith(target + '/');
---

<a href={withBase(target)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	a {
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	a:hover {
		color: var(--text);
		text-decoration: none;
	}
	a.active {
		color: var(--text);
		font-weight: 600;
	}
</style>
