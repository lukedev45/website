---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../utils';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const target = String(href);

// Normalize the current path back to a root-relative path (strip the base).
const base = import.meta.env.BASE_URL;
const current = ('/' + Astro.url.pathname.slice(base.length)).replace(/\/{2,}/g, '/');

const isActive = target === '/' ? current === '/' : current === target || current.startsWith(target + '/');
---

<a href={withBase(target)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
	{isActive && <span class="marker" aria-hidden="true" />}
</a>

<style>
	a {
		position: relative;
		font-family: var(--font-ui);
		color: var(--text-muted);
		font-size: 0.92rem;
	}
	a:hover {
		color: var(--text);
	}
	a.active {
		color: var(--text);
	}
	/*
	  Only the active link renders a marker, so the view-transition name is
	  unique per page — which is what lets the browser slide it from the old
	  link to the new one on navigation instead of fading one out and another in.
	  Marking the state with a rule rather than a bolder weight also keeps the
	  nav from reflowing as you move between pages.
	*/
	.marker {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.45rem;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
		view-transition-name: nav-active;
	}
</style>
