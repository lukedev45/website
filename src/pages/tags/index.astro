---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags, withBase } from '../../utils';

const tags = await getAllTags();
---

<BaseLayout title={`Tags · ${SITE_TITLE}`} description="Browse posts and projects by tag.">
	<h1>Tags</h1>
	{
		tags.length === 0 ? (
			<p class="muted">No tags yet.</p>
		) : (
			<ul class="tags-index">
				{tags.map(({ tag, slug, count }) => (
					<li>
						<a href={withBase(`/tags/${slug}/`)}>{tag}</a>
						<span class="muted">{count}</span>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.tags-index {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
	}
	.tags-index li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.65rem 0;
		border-bottom: 1px solid var(--border);
	}
</style>
