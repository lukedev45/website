---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils';
---

<BaseLayout title={`Not found · ${SITE_TITLE}`} description="Page not found.">
	<section class="notfound">
		<h1>404</h1>
		<p class="muted">That page doesn’t exist.</p>
		<p><a href={withBase('/')}>← Back home</a></p>
	</section>
</BaseLayout>

<style>
	.notfound {
		text-align: center;
		padding: 3rem 0;
	}
</style>
