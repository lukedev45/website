---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getProjects, getPublishedPosts, withBase } from '../utils';

const recentPosts = (await getPublishedPosts()).slice(0, 3);

const allProjects = await getProjects();
const featured = allProjects.filter((p) => p.data.featured);
const homeProjects = (featured.length ? featured : allProjects).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>Hi, I’m {AUTHOR}.</h1>
		<p class="lede">{SITE_DESCRIPTION}</p>
	</section>

	{
		recentPosts.length > 0 && (
			<section>
				<div class="section-head">
					<h2>Latest posts</h2>
					<a href={withBase('/blog')}>All posts →</a>
				</div>
				{recentPosts.map((post) => (
					<PostCard post={post} />
				))}
			</section>
		)
	}

	{
		homeProjects.length > 0 && (
			<section>
				<div class="section-head">
					<h2>Projects</h2>
					<a href={withBase('/projects')}>All projects →</a>
				</div>
				{homeProjects.map((project) => (
					<ProjectCard project={project} />
				))}
			</section>
		)
	}
</BaseLayout>

<style>
	.intro {
		margin-bottom: 1rem;
	}
	.lede {
		font-size: 1.15rem;
		color: var(--text-muted);
	}
</style>
