---
import { type CollectionEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, slugifyTag, withBase } from '../../utils';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, description, tags, repo, demo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description}>
	<article class="prose">
		<header class="post-header">
			<h1>{title}</h1>
			<p class="entry-desc">{description}</p>
			{
				(repo || demo) && (
					<p class="entry-links">
						{demo && (
							<a href={demo} target="_blank" rel="noopener">
								Live ↗
							</a>
						)}
						{repo && (
							<a href={repo} target="_blank" rel="noopener">
								Code ↗
							</a>
						)}
					</p>
				)
			}
			{
				tags.length > 0 && (
					<ul class="tag-list">
						{tags.map((tag) => (
							<li>
								<a href={withBase(`/tags/${slugifyTag(tag)}/`)}>{tag}</a>
							</li>
						))}
					</ul>
				)
			}
		</header>
		<Content />
	</article>
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

</style>
